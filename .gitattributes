# Normalize text line endings in the repository, check out native on Windows.
* text=auto

*.py   text diff=python
*.md   text
*.txt  text
*.toml text
*.spec text
*.html text

# Binary assets — never touch line endings, never try to diff.
*.ico  binary
*.png  binary
*.mp3  binary
*.mid  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.exe  binary
